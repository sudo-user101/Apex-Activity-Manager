<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apex Activity Manager (hardened runtime, not sandboxed).
  apple-events: Startup adds and removes login items through System Events,
  and Shell's Open in Terminal drives Terminal (both via osascript);
  without this the hardened runtime blocks them. Nothing else is needed: Apex uses no camera,
  microphone, location, contacts, calendars or photos, loads only Apple's own
  frameworks, and needs no JIT. Volume per app (menu bar › Sound) uses Core
  Audio process taps, which macOS asks about as "System Audio Recording"
  (NSAudioCaptureUsageDescription in Info.plist); it isn't the microphone,
  so no audio-input entitlement.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
