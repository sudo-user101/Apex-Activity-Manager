<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apex Activity Manager (hardened runtime, not sandboxed).
  apple-events: Startup adds and removes login items through System Events
  (via osascript); without this the hardened runtime blocks it. Nothing else is needed: Apex uses no camera,
  microphone, location, contacts, calendars or photos, loads only Apple's own
  frameworks, and needs no JIT.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
